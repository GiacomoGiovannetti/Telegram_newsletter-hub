DB_USER = 'John'
DB_PASSWORD = 'Doe'
DB_CLUSTER = "project.123"
DB_NAME = "dbname"
PORT= "0000"
NODE_ENV = "dev"
TELEGRAM_BOT_TOKEN = 'your-telegram-bot-token'
ALLOWED_TELEGRAM_USER_ID= 'your_telegram_user_id_here'
GMAIL_CLIENT_ID ="your-gmail-client-id"
GMAIL_CLIENT_SECRET="your-gmail-client-secret"
GMAIL_REDIRECT_URI="your-gmail-redirect-uri"
GMAIL_REFRESH_TOKEN="your-gmail-refresh-token"
GMAIL_TARGET_LABELS="your-gmail-target-labels"
WEBAPP_URL="https://your-webapp-domain.netlify.app"





NB: rename this file to '.env' and insert your data. 
NB: DB_USER, DB_PASSWORD, DB_CLUSTER, DB_NAME those are different parts of you mongoDB connection string 
NB: TELEGRAM_BOT_TOKEN is the token for your Telegram bot
NB: ALLOWED_TELEGRAM_USER_ID is the Telegram user ID allowed to interact with the bot
NB: WEBAPP_URL can contain one or more allowed origins (comma-separated)

